version: 2
ethernets:
  eth0:
    match:
      macaddress: "{{ vm_mac_address }}"
    set-name: eth0
    dhcp4: false
    dhcp6: false
    addresses:
      - {{ vm_ipv4_address }}
{% for net in vm_ipv6_networks %}
      - {{ net.address }}
{% endfor %}
    routes:
      - to: 0.0.0.0/0
        via: {{ vm_ipv4_gateway }}
{% for net in vm_ipv6_networks %}
      - to: ::/0
        via: {{ net.gateway }}
        table: {{ net.table }}
{% endfor %}
    routing-policy:
{% for net in vm_ipv6_networks %}
      - from: {{ net.prefix }}
        table: {{ net.table }}
{% endfor %}
      # Catch-all fallback so traffic sourced from an address outside both
      # prefixes above (e.g. a locally-originated connection before the
      # kernel has picked a source address) still resolves a default route,
      # instead of relying on a transient RA-learned route in the main
      # table that disappears once accept_ra is disabled.
      - table: {{ vm_ipv6_networks[-1].table }}
    nameservers:
      addresses:
{% for ns in vm_dns_servers %}
        - {{ ns }}
{% endfor %}
